# Copy to .env.test — use a dedicated DB, not the same as .env:
#   cp .env.test.example .env.test
#
# Used by:
#   npm run test
#   npm run test:watch
#   npm run test:migrate          # db push — local schema sync, not migration history
#   npm run test:migrate:deploy   # migrate deploy — same as prod
#
# Email peppers: two versions so rotation / stale-hash tests can run.
# See docs/email-hashing.md
# Auth cookies / JWT: see docs/auth.md

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/test_db"
NODE_ENV="test"
EMAIL_HASH_PEPPERS={"1":"test-email-hash-pepper-v1","2":"test-email-hash-pepper-v2"}
EMAIL_HASH_PEPPER_CURRENT=2
JWT_SECRET="replace-with-openssl-rand-base64-32"
MAX_AGE_ACCESS_TOKEN_MILLISECONDS=180000
MAX_AGE_REFRESH_TOKEN_MILLISECONDS=7776000000