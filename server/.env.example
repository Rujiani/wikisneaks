# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Versioned HMAC peppers for email hashes (JSON object: version → secret).
# Keep old versions until every user has reconfirmed under the current one, then drop them.
EMAIL_HASH_PEPPERS={"1":"replace-with-a-long-random-secret"}
EMAIL_HASH_PEPPER_CURRENT=1
