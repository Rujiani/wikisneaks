# Copy this file to `.env` and fill in real values.
# PostgreSQL >= 15.
# Auth cookies / JWT: see docs/auth.md
# Email HMAC peppers: see docs/email-hashing.md

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
NODE_ENV="development"
PORT=3000

# JSON object: version number → long random secret (32+ bytes recommended).
# Keep old versions until every user row is upgraded to CURRENT, then drop them.
EMAIL_HASH_PEPPERS={"1":"replace-with-a-long-random-secret"}
# Version used for newly written email hashes (must exist as a key above).
EMAIL_HASH_PEPPER_CURRENT=1

JWT_SECRET="replace-with-openssl-rand-base64-32"
# Access cookie + JWT lifetime (milliseconds). Example: 3 minutes.
MAX_AGE_ACCESS_TOKEN_MILLISECONDS=180000
# Refresh cookie, JWT, and ws_refresh_token.expires_at (milliseconds). Example: 90 days.
MAX_AGE_REFRESH_TOKEN_MILLISECONDS=7776000000